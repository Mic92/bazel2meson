# The core of MLIR's Python bindings, which jaxlib links into its common
# library. An installed MLIR does not ship it as a library, and LLVM's Bazel
# files are not part of its source tree. This is MLIRBindingsPythonCore from
# utils/bazel/llvm-project-overlay/mlir/BUILD.bazel. The package copies
# mlir/lib/Bindings/Python of the MLIR sources next to this file.

cc_library(
    name = "core",
    srcs = [
        "Python/Globals.cpp",
        "Python/IRAffine.cpp",
        "Python/IRAttributes.cpp",
        "Python/IRCore.cpp",
        "Python/IRInterfaces.cpp",
        "Python/IRRemarks.cpp",
        "Python/IRTypes.cpp",
        "Python/Pass.cpp",
        "Python/Rewrite.cpp",
    ],
    hdrs = glob(["Python/*.h"]),
    copts = [
        "-fexceptions",
        "-frtti",
    ],
    includes = ["Python"],
    visibility = ["//visibility:public"],
    deps = [
        "@llvm-project//mlir:CAPIAsync",
        "@llvm-project//mlir:CAPIDebug",
        "@llvm-project//mlir:CAPIIR",
        "@llvm-project//mlir:CAPIInterfaces",
        "@llvm-project//mlir:CAPITransforms",
        "@nanobind",
    ],
)
