# TableGen tools and the include directories of the installed .td files.
tblgen = {
  'llvm-tblgen': find_program('llvm-tblgen'),
  'mlir-tblgen': find_program('mlir-tblgen'),
}
tblgen_includes = []
# MLIR's CMake package loads LLVM's. Asking Meson for LLVM directly would go
# to its own LLVM handler, which has no CMake variables.
mlir_package = dependency('MLIR', method: 'cmake')
foreach variable : ['LLVM_INCLUDE_DIRS', 'MLIR_INCLUDE_DIRS']
  foreach dir : mlir_package.get_variable(cmake: variable).split(';')
    tblgen_includes += '-I' + dir
  endforeach
endforeach
