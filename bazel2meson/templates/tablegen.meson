# TableGen tools and the include directories of the installed .td files.
tblgen = {
  'llvm-tblgen': find_program('llvm-tblgen'),
  'mlir-tblgen': find_program('mlir-tblgen'),
}
tblgen_includes = []
foreach package : ['LLVM', 'MLIR']
  foreach dir : dependency(package, method: 'cmake').get_variable(cmake: package.to_upper() + '_INCLUDE_DIRS').split(';')
    tblgen_includes += '-I' + dir
  endforeach
endforeach
